{
  "name": "warhammer-rp-character-sheet",
  "version": "1.0.0",
  "description": "Warhammer Role-Playing Character Sheet with Multi-Agent Development",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "check": "svelte-kit sync && svelte-check",
    "sync": "svelte-kit sync",
    "prepare": "npm run smui-theme-light && npm run smui-theme-dark",
    "smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
    "smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark",
    "agents:explain": "node agents/scripts/simple-agent.js explain",
    "agents:workflow": "node agents/scripts/simple-agent.js workflow",
    "agents:task": "node agents/scripts/simple-agent.js task",
    "agent:plan": "node agents/scripts/simple-agent.js task planner",
    "agent:develop": "node agents/scripts/simple-agent.js task developer",
    "agent:senior": "node agents/scripts/simple-agent.js task senior_developer",
    "agent:verify": "node agents/scripts/simple-agent.js task verifier",
    "claude:orchestrate": "node agents/scripts/claude-code-orchestrator.js"
  },
  "keywords": [
    "warhammer",
    "rpg",
    "character-sheet",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^1.0.0",
    "@mdi/js": "^7.4.47",
    "@smui/button": "^8.0.3",
    "@smui/checkbox": "^8.0.3",
    "@smui/form-field": "^8.0.3",
    "@smui/select": "^8.0.3",
    "@smui/textfield": "^8.0.3",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.43.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "happy-dom": "^19.0.2",
    "smui-theme": "^8.0.3",
    "svelte": "^5.39.8",
    "typescript": "^5.0.0",
    "vite": "^6.3.6",
    "vite-plugin-vercel": "^9.0.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
  }
}
